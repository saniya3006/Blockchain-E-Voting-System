# ============================================================
# BlockVote - environment variables
# Copy this file to ".env" (in the project root) and fill in values.
# NEVER commit your real .env file - it is listed in .gitignore.
# ============================================================

# ---------- Frontend (read by Vite; only VITE_* values reach the browser) ----------
# Leave these EMPTY for local development: `npm run deploy:local` automatically
# writes the address, chain id and ABI to frontend/src/contracts/Voting.json.
# Set them only if you want to point the UI at a different deployment.
VITE_CONTRACT_ADDRESS=
# 31337 = local Hardhat network, 11155111 = Sepolia testnet
VITE_CHAIN_ID=
# RPC used to READ blockchain data (e.g. http://127.0.0.1:8545 or a Sepolia RPC URL)
VITE_RPC_URL=

# ---------- Hardhat (only needed for the optional Sepolia deployment) ----------
# RPC endpoint for Sepolia, e.g. from Alchemy / Infura / a public provider
SEPOLIA_RPC_URL=
# Private key of a TEST-ONLY wallet that holds Sepolia test ETH.
# Never use a wallet that holds real money.
PRIVATE_KEY=
# Optional: for `npx hardhat verify`
ETHERSCAN_API_KEY=
